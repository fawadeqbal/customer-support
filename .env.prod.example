# Copy to .env.prod on the server and fill in. Never commit .env.prod.
# Make random values with:  openssl rand -hex 16
RAG_DB_PASSWORD=change-me
ADMIN_TOKEN=change-me
# Support console at /admin: sign in with ADMIN_TOKEN. Queue wait estimates use these:
SUPPORT_AGENTS=2
AVG_HANDLE_MINUTES=5

# ---- Models (see backend/docs/PROVIDERS.md) ----
# Default: everything local. The LLM runs in the rag-ollama container.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b          # 2-core server: qwen2.5:1.5b answers about twice as fast

# Switch the answers to Claude instead:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=sk-ant-api03-...
